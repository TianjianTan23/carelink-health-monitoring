{
  "name": "carelink-health-monitoring",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "CareLink heart-rate, temperature and fall monitoring dashboard with FastAPI and SQLite",
  "scripts": {
    "start": "sh scripts/start-local-mac.sh",
    "start:web": "vite --host 0.0.0.0",
    "start:api": ".venv/bin/python -m uvicorn backend.app:app --host 0.0.0.0 --port 8000",
    "simulate:sensors": "node scripts/simulate-sensor.mjs",
    "test": "node --test tests/*.test.mjs && vitest run",
    "generate:shared": "node scripts/generate-shared.mjs",
    "test:ios-core": "sh ios/test-core.sh",
    "pretest": "node scripts/build-mobile-review.mjs",
    "review:mobile": "node scripts/build-mobile-review.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "legacy": "node server.mjs",
    "test:legacy": "node --test tests/*.test.mjs",
    "test:react": "vitest run",
    "generate:tokens": "python3 scripts/generate-design-tokens.py",
    "prebuild": "node scripts/generate-shared.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/node": "^22",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "jsdom": "^27",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@testing-library/jest-dom": "^6"
  }
}
