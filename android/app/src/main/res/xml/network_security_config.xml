<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors><certificates src="system"/><certificates src="user"/></trust-anchors>
  </base-config>
  <!-- Existing local gateway identity. Public CA only; never bundle its key.
       Limit this additional trust to the configured LAN gateway and emulator.
       Standard certificate validity and hostname verification still apply. -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="false">172.20.10.11</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <trust-anchors>
      <certificates src="system"/>
      <certificates src="user"/>
      <certificates src="@raw/carelink_gateway_ca"/>
    </trust-anchors>
  </domain-config>
</network-security-config>
